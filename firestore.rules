rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper: check whether a user holds an active (non-revoked) GrantedContact
    // relationship for a given owner's evidence.
    // -----------------------------------------------------------------------
    function isActiveGrantedContact(uid, ownerId) {
      return exists(/databases/$(database)/documents/grantedContacts/$(ownerId)/contacts/$(uid))
        && get(/databases/$(database)/documents/grantedContacts/$(ownerId)/contacts/$(uid)).data.revoked != true;
    }

    // -----------------------------------------------------------------------
    // /evidence/{evidenceId}
    //
    // Write-once from the client:
    //   - allow create: authenticated user, document owned by creator, initial
    //                   status must be 'uploading' (Req 6.1, 11.2)
    //   - allow read:   owner OR active non-revoked GrantedContact (Req 7.1, 7.2)
    //   - allow update: DENY ALL — no client carve-outs whatsoever.
    //                   All post-creation writes go through Cloud Functions via
    //                   Admin SDK, which bypasses these rules entirely. (Req 6.2, 6.4)
    //                   The previously-considered 'failed' carve-out was removed
    //                   because it created an exploitable race window (see design.md
    //                   §Client Write Carve-Out: Security Analysis and Resolution).
    //   - allow delete: DENY ALL (Req 6.3)
    // -----------------------------------------------------------------------
    match /evidence/{evidenceId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'uploading';

      // Allow read for: owner of existing doc, active granted contact,
      // OR authenticated user checking for their own non-existent doc
      // (needed for the idempotency check in the upload flow — getDoc on a
      // missing document triggers this rule; resource is null for missing docs
      // so resource.data checks fail without this additional condition).
      allow read: if request.auth != null
                  && (
                    (resource != null && resource.data.userId == request.auth.uid)
                    || (resource != null && isActiveGrantedContact(request.auth.uid, resource.data.userId))
                    || resource == null
                  );

      // No client update exceptions — fully write-once after creation.
      allow update: if false;

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // /grantedContacts/{ownerId}/contacts/{contactUid}
    //
    // Written exclusively by grantEvidenceAccess and revokeEvidenceAccess
    // Cloud Functions via Admin SDK. Clients may not read or write this
    // sub-collection directly.
    // -----------------------------------------------------------------------
    match /grantedContacts/{ownerId}/contacts/{contactUid} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // /sosSessions/{sessionId}
    //
    // Write-once from client is denied completely: all writes go through Cloud
    // Functions via Admin SDK (Req 3, design.md §Firestore Security Rules).
    //
    // Read: authenticated owner only.
    // -----------------------------------------------------------------------
    match /sosSessions/{sessionId} {
      // Owner can always read their own session.
      // Assigned guardians (those with a matching guardian_pings doc) can also read
      // to fetch the victim's live location coordinates for the map.
      allow read: if request.auth != null
                    && (
                      resource.data.userId == request.auth.uid
                      || exists(/databases/$(database)/documents/guardian_pings/$(sessionId + '_' + request.auth.uid))
                    );

      // Owner may update their own session (used for live location streaming).
      // All other writes (status transitions) go through Admin SDK — denied here.
      allow update: if request.auth != null
                      && resource.data.userId == request.auth.uid;

      allow create, delete: if false;
    }

    // -----------------------------------------------------------------------
    // /guardians/{guardianId}
    //
    // Write: only the authenticated owner can write/update their onDuty status or currentLocation.
    // Read: only the authenticated owner can read their profile. Other clients are blocked
    //       from reading guardian details or currentLocations.
    // -----------------------------------------------------------------------
    match /guardians/{guardianId} {
      allow read, write: if request.auth != null && request.auth.uid == guardianId;
    }

    // -----------------------------------------------------------------------
    // /guardian_pings/{pingId}
    //
    // Read: only the specific guardian assigned to the ping can read it.
    // Write: client writes are denied entirely.
    // -----------------------------------------------------------------------
    match /guardian_pings/{pingId} {
      // Assigned guardian can read their own ping
      allow read: if request.auth != null && resource.data.guardianId == request.auth.uid;
      // Victim (SOS session owner) can read pings for their session — response count only,
      // not guardian identity. The client only uses snap.size, never guardian UIDs.
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/sosSessions/$(resource.data.sosSessionId))
                  && get(/databases/$(database)/documents/sosSessions/$(resource.data.sosSessionId)).data.userId == request.auth.uid;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // /users/{userId}
    //
    // Permits owner read/write of their user document, which will contain
    // silentActivationConfig. Enforces that duressPinHash (if present)
    // is a valid bcrypt cost=10 hash to prevent plaintext PIN writes.
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if request.auth != null
                    && request.auth.uid == userId;
      allow write: if request.auth != null
                     && request.auth.uid == userId
                     && (
                       !('silentActivationConfig' in request.resource.data)
                       || (
                         request.resource.data.silentActivationConfig is map
                         && (
                           !('duressPinHash' in request.resource.data.silentActivationConfig)
                           || (
                             request.resource.data.silentActivationConfig.duressPinHash is string
                             && request.resource.data.silentActivationConfig.duressPinHash.matches('^\\$2[abx]\\$10\\$[./A-Za-z0-9]{53}$')
                           )
                         )
                         // normalPinHash must also be a valid bcrypt cost=10 hash if present
                         && (
                           !('normalPinHash' in request.resource.data.silentActivationConfig)
                           || (
                             request.resource.data.silentActivationConfig.normalPinHash is string
                             && request.resource.data.silentActivationConfig.normalPinHash.matches('^\\$2[abx]\\$10\\$[./A-Za-z0-9]{53}$')
                           )
                         )
                       )
                     );
    }

    // Catch-all: deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

