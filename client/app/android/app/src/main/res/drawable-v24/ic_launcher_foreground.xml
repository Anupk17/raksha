<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily Notes launcher foreground — white notebook outline with ruling lines
  and a diagonal pencil. Safe zone: artwork within central 72×72dp of 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Notebook outer rect -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="4"
      android:fillColor="#00000000"
      android:pathData="M22,14 L78,14 L78,94 L22,94 Z" />

  <!-- Spine line -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="3"
      android:fillColor="#00000000"
      android:pathData="M33,14 L33,94" />

  <!-- Ruling line 1 -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="2.5"
      android:fillColor="#00000000"
      android:pathData="M40,44 L71,44" />

  <!-- Ruling line 2 -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="2.5"
      android:fillColor="#00000000"
      android:pathData="M40,57 L71,57" />

  <!-- Ruling line 3 -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="2.5"
      android:fillColor="#00000000"
      android:pathData="M40,70 L71,70" />

  <!-- Pencil body — diagonal from mid to bottom-right -->
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="5"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M58,58 L82,82" />

  <!-- Pencil tip -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M82,82 L76,86 L86,76 Z" />

</vector>
