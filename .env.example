# ============================================================
# RAKSHA Cloud Functions — Environment Variables
# ============================================================
# Copy this file to .env and fill in your project-specific values.
# NEVER commit .env to version control.
#
# Evidence Trail variables (pre-existing):
# KMS_KEY_RING_REF=projects/{project}/locations/{location}/keyRings/{ring}
#
# ============================================================
# Silent Activation — Cloud Tasks (Task 0.5)
# ============================================================

# Fully-qualified Cloud Tasks queue resource name.
# Format: projects/{project}/locations/{location}/queues/sos-session-activate
# Example: projects/raksha-prod/locations/us-central1/queues/sos-session-activate
CLOUD_TASKS_QUEUE=projects/YOUR_PROJECT/locations/YOUR_REGION/queues/sos-session-activate

# GCP region where the queue is provisioned (must match CLOUD_TASKS_QUEUE).
# Example: us-central1
CLOUD_TASKS_LOCATION=YOUR_REGION

# HTTPS URL that Cloud Tasks will POST to for the activateSOSSession handler.
# This is the deployed Cloud Functions URL for the activateSOSSession endpoint.
# Example: https://us-central1-raksha-prod.cloudfunctions.net/activateSOSSession
CLOUD_TASKS_HANDLER_URL=https://YOUR_REGION-YOUR_PROJECT.cloudfunctions.net/activateSOSSession
